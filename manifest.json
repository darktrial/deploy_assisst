{
  "manifest_version": 3,
  "name": "GT One-Click Dispatch",
  "version": "1.4.0",
  "description": "Select a resource point, apply army preset slot 1, dispatch, and speed up until estimated travel time is at most 1 second.",
  "minimum_chrome_version": "125",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://game.gtarcade.com/*",
    "https://logins-gotpc.gtarcade.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://game.gtarcade.com/game*",
        "https://logins-gotpc.gtarcade.com/*"
      ],
      "js": [
        "hotkey.js",
        "auto-trigger.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "F8: preset slot 1 → dispatch → speed up to ≤ 1 second"
  },
  "options_ui": {
    "page": "status.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+G"
      }
    },
    "stop": {
      "suggested_key": {
        "default": "Alt+Shift+X"
      },
      "description": "Stop further one-click dispatch actions"
    }
  }
}

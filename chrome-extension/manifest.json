{
  "manifest_version": 3,
  "name": "GT Gathering Helper",
  "version": "0.3.1",
  "description": "Native resource gathering, traffic observation, and army preset workflows.",
  "minimum_chrome_version": "125",
  "permissions": [
    "storage",
    "debugger"
  ],
  "host_permissions": [
    "https://game.gtarcade.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open GT Gathering Helper"
  },
  "commands": {
    "stop": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Stop further actions or traffic observation"
    },
    "mark-preset": {
      "suggested_key": {
        "default": "Alt+Shift+1"
      },
      "description": "Mark: about to select an army preset"
    },
    "mark-march": {
      "suggested_key": {
        "default": "Alt+Shift+2"
      },
      "description": "Mark: about to dispatch"
    },
    "mark-boost": {
      "suggested_key": {
        "default": "Alt+Shift+3"
      },
      "description": "Mark: about to use a speedup"
    }
  }
}
